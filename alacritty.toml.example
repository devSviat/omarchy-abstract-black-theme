# Abstract Black — Alacritty. Hand-written so the window can carry alpha; see
# foot.ini. Hyprland does the blurring.
[window]
opacity = 0.72
# Ask the compositor for blur explicitly; see the note in foot.ini.
blur = true

[colors.primary]
background = "#0b0b0b"
foreground = "#d7dae0"

[colors.cursor]
text = "#0b0b0b"
cursor = "#ffffff"

[colors.vi_mode_cursor]
text = "#0b0b0b"
cursor = "#ffffff"

[colors.search.matches]
foreground = "#0b0b0b"
background = "#ecc46a"

[colors.search.focused_match]
foreground = "#0b0b0b"
background = "#e5545a"

[colors.footer_bar]
foreground = "#0b0b0b"
background = "#d7dae0"

[colors.selection]
text = "#ffffff"
background = "#202329"

[colors.normal]
black = "#0b0b0b"
red = "#e5545a"
green = "#57d9a3"
yellow = "#ecc46a"
blue = "#5aa2f0"
magenta = "#a67cf0"
cyan = "#5cd0e0"
white = "#d7dae0"

[colors.bright]
black = "#5a5f6b"
red = "#ff757b"
green = "#7ceac0"
yellow = "#f7d68a"
blue = "#86bcff"
magenta = "#c29aff"
cyan = "#8ae0ee"
white = "#ffffff"
