-- Abstract Black — Hyprland side of the theme.
--
-- Named .example because omarchy-theme-set drops every *.lua from a theme
-- cloned by `omarchy theme install`; the full install in README.md links it in
-- as hyprland.lua.
--
-- Hand-written instead of generated from default/themed/hyprland.lua.tpl: the
-- template only emits border colours, and this theme's whole point is the
-- glass — blur, window translucency, blurred shell surfaces, animation. A
-- template never overwrites a file the theme ships, so the border values below
-- are no longer generated and must be kept in step with
-- `hyprland_active_border` / `hyprland_inactive_border` in colors.toml.
--
-- Load order (default/hypr/omarchy.lua, then ~/.config/hypr/hyprland.lua):
--
--   default.hypr.looknfeel         blur and shadow off, rounding 0
--   default.hypr.windows           default-opacity tag -> "0.985 0.96"
--   omarchy.current.theme.hyprland  <- this file
--   hypr.looknfeel                 the user's own overrides, loaded last
--
-- The window rules here are declared after Omarchy's, so for the same property
-- they win. Anything set in ~/.config/hypr/looknfeel.lua still wins over this
-- file.

-- `hl` and `o` are injected as globals by Hyprland's Lua runtime and Omarchy's
-- helpers, so a language server has nothing to resolve them against.
---@diagnostic disable-next-line: undefined-global
local hl = hl
---@diagnostic disable-next-line: undefined-global
local o = o

-- A glass rim lit from above: pale silver (#d7e4f8, 40%) catching the top edge
-- and settling into the accent (#8fb4de, 18%) at the bottom, top to bottom at
-- 90 degrees. On translucent, blurred windows that reads as the edge of a pane
-- catching moonlight rather than as a coloured frame.
-- colors.toml hyprland_active_border.
local active_border_color = { colors = { "rgba(d7e4f866)", "rgba(8fb4de2e)" }, angle = 90 }
-- colors.toml hyprland_inactive_border: `selection` (#202329) at 50%, a soft
-- graphite edge in the same glass as the bar and the windows.
local inactive_border_color = "rgba(20232980)"

hl.config({
  general = {
    gaps_in = 4,
    gaps_out = 9,
    border_size = 2,

    col = {
      active_border = active_border_color,
      inactive_border = inactive_border_color,
    },
  },

  group = {
    col = {
      border_active = active_border_color,
      border_inactive = inactive_border_color,
    },
  },

  decoration = {
    -- The lattice wallpaper is built from generously rounded extrusions, not
    -- from sharp rectangles; 14 puts the windows in the same family as the
    -- shapes behind them.
    rounding = 14,
    -- Above 2 the corner becomes a superellipse instead of a circular arc — a
    -- continuous curve rather than an arc spliced onto two straight edges. At
    -- this radius 3 reads as visibly squared-off, so 2.5 keeps the softness
    -- while staying a true rounded corner. The shell reads decoration:rounding
    -- for its own corner radius, so bar panels, menus and notifications follow.
    rounding_power = 2.5,

    -- Both wallpapers are lit from the upper left and cast their shadows down
    -- and to the right; the windows do the same, so they sit in the same light
    -- as what is behind them rather than floating in a symmetric halo.
    shadow = {
      enabled = true,
      range = 30,
      render_power = 3,
      offset = { 3, 6 },
      color = "rgba(0505059e)",
      color_inactive = "rgba(0505056b)",
    },

    -- Frosted glass. Three passes at size 9 is a wide, smooth blur without
    -- banding.
    --
    -- Two values differ from the usual glass recipe because these wallpapers
    -- are near-black already: brightness stays at 0.80 rather than dropping
    -- further (there is nothing bright behind the windows to pull down, and a
    -- lower value turns the blur to mud), and vibrancy is nearly off — it
    -- saturates what it blurs, and on an achromatic wallpaper that can only
    -- invent a colour cast out of sensor noise and JPEG artifacts.
    blur = {
      enabled = true,
      size = 9,
      passes = 3,
      noise = 0.015,
      contrast = 1.0,
      brightness = 0.80,
      vibrancy = 0.10,
      vibrancy_darkness = 0.3,
      new_optimizations = true,
      xray = false,
      ignore_opacity = true,
      special = true,
      -- Menus and tooltips of translucent apps (GTK popovers, context menus).
      -- Only pixels denser than 0.5 are frosted: the menu body (0.88 in
      -- gtk.css) is, its drop shadow (kept at or below 0.35) is not. Lower and
      -- the shadow itself is blurred and darkened into a band around menus.
      popups = true,
      popups_ignorealpha = 0.5,
    },
  },
})

-- Animations. Omarchy's defaults (default.hypr.looknfeel) are brisk and turn
-- workspace switching off; this set gives the glass some motion. Speeds are in
-- tenths of a second and match omarchy-star-wars-theme exactly, which is the
-- pacing this theme was asked for; only the curve names differ.
--
--   lift    fast with a slight overshoot — a pane rising into place
--   settle  eases in, then gone
--   glide   long ease-out, for anything that moves or changes colour
--   shift   slow start, hard jump, soft landing — workspace switches
--
-- The bar and menus keep Omarchy's own no_anim layer rules, so they still pop
-- instantly.
hl.curve("lift", { type = "bezier", points = { { 0.16, 1 }, { 0.3, 1.08 } } })
hl.curve("settle", { type = "bezier", points = { { 0.6, 0.04 }, { 0.98, 0.34 } } })
hl.curve("glide", { type = "bezier", points = { { 0.22, 1 }, { 0.36, 1 } } })
hl.curve("shift", { type = "bezier", points = { { 0.76, 0 }, { 0.24, 1 } } })

hl.animation({ leaf = "windowsIn", enabled = true, speed = 4.5, bezier = "lift", style = "popin 70%" })
hl.animation({ leaf = "windowsOut", enabled = true, speed = 2.5, bezier = "settle", style = "popin 70%" })
hl.animation({ leaf = "windowsMove", enabled = true, speed = 4, bezier = "glide", style = "slide" })
hl.animation({ leaf = "border", enabled = true, speed = 6, bezier = "glide" })
hl.animation({ leaf = "fadeIn", enabled = true, speed = 3, bezier = "glide" })
hl.animation({ leaf = "fadeOut", enabled = true, speed = 2.5, bezier = "settle" })
-- Focus moving across translucent windows fades their opacity rather than
-- snapping between 0.9 and 0.82.
hl.animation({ leaf = "fadeSwitch", enabled = true, speed = 4, bezier = "glide" })
hl.animation({ leaf = "fadeShadow", enabled = true, speed = 4, bezier = "glide" })
hl.animation({ leaf = "workspaces", enabled = true, speed = 2.5, bezier = "shift", style = "slidefade 20%" })
hl.animation({ leaf = "specialWorkspace", enabled = true, speed = 4, bezier = "lift", style = "slidefadevert 30%" })
hl.animation({ leaf = "layersIn", enabled = true, speed = 3, bezier = "glide", style = "fade" })
hl.animation({ leaf = "layersOut", enabled = true, speed = 2, bezier = "settle", style = "fade" })

-- Window translucency, active then inactive. Omarchy's default is
-- "0.985 0.96"; browsers, video players, games, PiP and screen-share targets
-- drop the default-opacity tag in default/hypr/apps/, so they stay opaque.
o.window({ tag = "default-opacity" }, { opacity = "0.9 0.82" })

-- Terminals carry their own background alpha (foot.ini, ghostty.conf,
-- alacritty.toml, kitty.conf), which keeps glyphs fully opaque over a
-- translucent cell background. Whole-window opacity on top would also fade the
-- text, so they are only dimmed slightly when unfocused. Declared after the
-- default-opacity rule above so it wins for terminal windows.
o.window({ tag = "terminal" }, { opacity = "1.0 0.94" })

-- The screenshot editor shows a capture of the desktop; at 0.9 that capture
-- blends with the same windows behind it. Omarchy's opaque media list
-- (default/hypr/apps/system.lua) does not include Tensaku, so it is added here.
o.window("dev.tensaku.Tensaku", { tag = "-default-opacity", opacity = "1 1" })

-- Blur behind the Omarchy shell's own layer surfaces. Their alpha comes from
-- the shell.*.toml sections; ignore_alpha skips blurring any pixel at or below
-- that alpha.
--
-- The bar is a strip of glass at 0.62, so it takes a low threshold that only
-- skips its fully transparent edges. blur_popups also frosts the xdg popups
-- the bar opens (tray menus, media, tooltips).
hl.layer_rule({ match = { namespace = "^omarchy-bar$" }, blur = true, blur_popups = true, ignore_alpha = 0.15 })

-- Everything else is a full-screen layer: a scrim (0.1 in shell.menu.toml /
-- shell.launcher.toml, 0.45 for polkit, 0.5 for the image picker) with a card
-- on top (0.62 - 0.9). A threshold of 0.55 sits between the two, so only the
-- card is frosted and the desktop around it stays sharp and visible, rather
-- than the whole screen going to a dark blur whenever a menu opens.
hl.layer_rule({
  match = {
    namespace = "^(omarchy-menu|omarchy-notifications|omarchy-osd|omarchy-polkit|omarchy-clipboard|omarchy-emojis|omarchy-keyboard-panel|omarchy-reminders|omarchy-network-qr|omarchy-image-selector)$",
  },
  blur = true,
  blur_popups = true,
  ignore_alpha = 0.55,
})

-- This theme is Hyprland's own blur, deliberately: no compositor plugin, and
-- nothing here loads one. If hyprglass happens to be loaded from the user's
-- autostart for some other theme, switch it off rather than inherit its
-- refraction — the plugin stays loaded but draws nothing.
if hl.plugin and hl.plugin.hyprglass then
  hl.plugin.hyprglass.config({ enabled = false, layers = { enabled = false } })
end
